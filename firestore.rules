rules_version = '2';
// Family Calendar security rules.
// - Sam (owner) and anyone in a space's `editors` list can change everything.
// - Anyone holding the space's secret id (the family link) can read shared events
//   and add events to the "Family & Friends" calendar.
// - Private events (Family calendar, or marked "only us") are readable by editors only.
service cloud.firestore {
  match /databases/{database}/documents {
    function me() { return request.auth != null ? request.auth.token.email.lower() : ''; }
    function isOwner() { return me() in ['sam.ahlersmeyer@gmail.com', 'samahlersmeyer@gmail.com']; }
    function isEditor(space) {
      return isOwner() || (request.auth != null && me() in get(/databases/$(database)/documents/spaces/$(space)).data.editors);
    }

    // Where a signed-in editor finds their calendar.
    match /editors/{email} {
      allow get: if me() == email || isOwner();
      allow list: if false;
      allow create, update: if isEditor(request.resource.data.space);
      allow delete: if isEditor(resource.data.space);
    }

    // Family code ("Ahlersmeyer") → calendar. Stored hashed; can't be listed.
    match /codes/{h} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isEditor(request.resource.data.space);
      allow delete: if isEditor(resource.data.space);
    }

    // A kitchen display (Echo) paired by Sam or Emily: signed in anonymously, listed in /spaces/{space}/displays.
    function isDisplay(space) {
      return request.auth != null && exists(/databases/$(database)/documents/spaces/$(space)/displays/$(request.auth.uid));
    }

    match /spaces/{space} {
      allow get: if true;          // needs the secret id
      allow list: if false;        // nobody can browse for spaces
      allow create: if isOwner();
      allow update, delete: if isEditor(space);

      match /events/{eventId} {
        allow get, list: if resource.data.shared == true || isEditor(space) || isDisplay(space);
        allow create: if isEditor(space) || (
          // relatives' events wait for Sam or Emily to approve (hidden from everyone until then)
          request.resource.data.cal == 'friends'
          && request.resource.data.shared == false
          && request.resource.data.pending == true
          && request.resource.data.addedBy is string
          && request.resource.data.addedBy.size() < 80
          && request.resource.data.title is string
          && request.resource.data.title.size() < 200
          && request.resource.data.keys().hasOnly(['id', 'cal', 'title', 'start', 'end', 'allDay', 'location', 'notes', 'addedBy', 'source', 'shared', 'pending', 'createdAt'])
        );
        allow update, delete: if isEditor(space);
      }

      // "Who's driving?" — anyone with the family link can sign up to drive.
      match /rides/{eventId} {
        allow get, list: if true;
        allow delete: if true;
        allow create, update: if request.resource.data.keys().hasOnly(['driver', 'at'])
          && request.resource.data.driver is string
          && request.resource.data.driver.size() > 0
          && request.resource.data.driver.size() < 60;
      }

      // Groceries and chores — anyone with the family link (phones, the kitchen display) can check things off.
      match /items/{itemId} {
        allow get, list: if true;
        allow delete: if true;
        allow create, update: if request.resource.data.keys().hasOnly(['id', 'list', 'text', 'who', 'done', 'doneOn', 'repeat', 'days', 'by', 'at'])
          && request.resource.data.list in ['shop', 'todo']
          && (!('days' in request.resource.data) || (request.resource.data.days is list && request.resource.data.days.size() <= 7))
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() < 200;
      }

      // Phone notifications. The id is a hash of the phone's secret push address, so it can't be guessed or listed.
      // Only a signed-in editor can ask for editor notifications (which include private events).
      match /push/{subId} {
        allow get, delete: if true;
        allow list: if false;
        allow create, update: if request.resource.data.keys().hasOnly(['sub', 'name', 'editor', 'email', 'remind', 'changes', 'weekly', 'practices', 'kid', 'at'])
          && request.resource.data.sub is map
          && (request.resource.data.editor != true || (isEditor(space) && request.resource.data.email == me()));
      }

      // Kitchen display pairing: the Echo posts a 6-digit code; an editor reads it and approves the Echo.
      match /pairing/{code} {
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['uid', 'at'])
          && request.resource.data.uid == request.auth.uid;
        allow get: if isEditor(space);
        allow list: if false;
        allow delete: if isEditor(space);
      }
      match /displays/{uid} {
        allow get: if isEditor(space) || (request.auth != null && request.auth.uid == uid);
        allow list, create, update: if isEditor(space);
        allow delete: if isEditor(space) || (request.auth != null && request.auth.uid == uid);
      }

      // Editors-only settings (weekly email recipients and the Gmail app password that sends it).
      match /private/{docId} {
        allow read, write: if isEditor(space);
      }

      match /files/{fileId} {
        allow get: if true;
        allow list: if false;
        allow write: if isEditor(space);
        match /chunks/{n} {
          allow get: if true;
          allow list: if false;
          allow write: if isEditor(space);
        }
      }
    }
  }
}
